class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {
        int n = nums.size();
        if(k==0)
        {
            return false;
        }
        for(int i=0;i<n;i++)
        {
            int j = i+k < n ? i+k:n-1;
            while(j>i)
            {
                if(nums[i]==nums[j])
                {
                    return true;
                }
                j--;
            }
        }
        return false;
    }
};
